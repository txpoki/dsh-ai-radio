{
  "name": "dsh-ai-radio",
  "version": "0.2.5",
  "description": "A continuous personal AI radio for DeepSeek Harness: NetEase playlists, contextual DJs, fresh news and crossfade.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-radio",
    "netease",
    "tts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txpoki/dsh-ai-radio.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:startup": "node test/startup-browser.mjs",
    "test:mix": "node test/mix-browser.mjs",
    "test:daily": "node test/daily-browser.mjs",
    "test:voice": "node test/voice-browser.mjs",
    "test:editorial": "node test/editorial-browser.mjs",
    "check": "node scripts/check.mjs",
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "music-metadata": "11.16.1",
    "node-edge-tts": "1.2.12"
  }
}
